<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Install phase: the app downloads catalog images itself. The guest's
         user-mode stack remains the engine's own. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Reading the active network's DNS servers for the guest's resolver. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Keep the CPU awake while an install unpacks; the screen timer is
         also held during installs (mirrors iOS isIdleTimerDisabled). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Crate"
        android:theme="@style/Theme.Crate">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
