<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Install phase: the app downloads catalog images itself. The guest's
         user-mode stack remains the engine's own. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Keep the CPU awake while an install unpacks; the screen timer is
         also held during installs (mirrors iOS isIdleTimerDisabled). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <application
        android:allowBackup="false"
        android:theme="@style/Theme.Crate">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
