 /// The range must be mapped and readable.
-#[cfg(all(target_os = "linux", target_arch = "aarch64"))]
+#[cfg(all(any(target_os = "linux", target_os = "android"), target_arch = "aarch64"))]
 unsafe fn flush_icache(start: *mut u8, len: usize) {
