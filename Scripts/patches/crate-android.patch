diff --git a/crates/crate-jit/src/backend.rs b/crates/crate-jit/src/backend.rs
index 2c2b247..88e0995 100644
--- a/crates/crate-jit/src/backend.rs
+++ b/crates/crate-jit/src/backend.rs
@@ -37,8 +37,8 @@ unsafe extern "C" {
 
 core::arch::global_asm!(
     ".p2align 2",
-    ".globl _crate_jit_enter",
-    "_crate_jit_enter:",
+    ".globl {enter}",
+    "{enter}:",
     // Save the host's callee-saved registers and make a frame.
     "stp x29, x30, [sp, #-176]!",
     "stp x19, x20, [sp, #16]",
@@ -97,8 +97,8 @@ core::arch::global_asm!(
     // Jump to the block.
     "ldr x16, [sp, #{dispatch}]",
     "br x16",
-    ".globl _crate_jit_epilogue",
-    "_crate_jit_epilogue:",
+    ".globl {epilogue}",
+    "{epilogue}:",
     // Reached from a stub with SP = state block; return the exit code.
     "ldr w0, [sp, #{exit}]",
     "ldr x9, [sp, #{host_sp}]",
@@ -121,6 +121,8 @@ core::arch::global_asm!(
     x = const offsets::X,
     dispatch = const offsets::DISPATCH_TARGET,
     exit = const offsets::EXIT,
+    enter = sym crate_jit_enter,
+    epilogue = sym crate_jit_epilogue,
 );
 
