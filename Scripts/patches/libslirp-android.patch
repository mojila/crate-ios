--- a/src/slirp.c
+++ b/src/slirp.c
@@ -389,6 +389,17 @@
 #define RESOLV_CONF_PATH "/etc/resolv.conf"
 #endif
 
+/* Android has no /etc/resolv.conf: bionic reads DNS through netd, which a
+ * native library can't reach. The app writes the phone's current DNS
+ * servers to its own file and points SLIRP_RESOLV_CONF at it; without the
+ * variable the default path above is used, as before. */
+#include <stdlib.h>
+static const char *resolv_conf_path(void)
+{
+    const char *env = getenv("SLIRP_RESOLV_CONF");
+    return (env && *env) ? env : RESOLV_CONF_PATH;
+}
